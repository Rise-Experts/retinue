{
  "name": "@retinue/shareflow",
  "version": "0.1.0",
  "private": true,
  "description": "An integration package for one product. Its tools, prompts and parity gates are specific to ShareFlow and are not a supported extension point.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "parity": "tsc -b && node scripts/parity-report.mjs",
    "scan:old-runtime": "tsc -b && node scripts/scan-old-runtime.mjs",
    "scan:old-runtime-capabilities": "node scripts/scan-old-runtime-capabilities.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/azure": "^4.0.49",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/mistral": "^4.0.33",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@retinue/agentkit": "^0.3.0",
    "@whatwg-node/server": "^0.11.0",
    "bullmq": "^6.2.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Rise Experts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rise-Experts/retinue.git",
    "directory": "shareflow"
  }
}
