{
  "name": "@retinue/shareflow",
  "version": "0.1.0",
  "private": true,
  "description": "An integration package for one product. Its tools, prompts and parity gates are specific to ShareFlow and are not a supported extension point.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "parity": "tsc -b && node scripts/parity-report.mjs",
    "scan:old-runtime": "tsc -b && node scripts/scan-old-runtime.mjs"
  },
  "dependencies": {
    "@retinue/agentkit": "^0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Rise Experts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rise-Experts/retinue.git",
    "directory": "shareflow"
  }
}
