    "graphql-yoga": "^5.10.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "vitest": "^3.0.0 || ^4.0.0",
    "@electric-sql/pglite": "^0.2.0 || ^0.3.0"
  },
  "peerDependenciesMeta": {
