{
  "name": "@retinue/agentkit",
  "version": "0.2.0",
  "description": "A provider-neutral, durable AI agent runtime for TypeScript: agents, tools, approvals, context, knowledge and persistence behind ports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/entries/runtime.d.ts",
      "default": "./dist/entries/runtime.js"
    },
    "./tools": {
      "types": "./dist/entries/tools.d.ts",
      "default": "./dist/entries/tools.js"
    },
    "./flows": {
      "types": "./dist/entries/flows.d.ts",
      "default": "./dist/entries/flows.js"
    },
