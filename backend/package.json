      "types": "./dist/entries/persistence.d.ts",
      "default": "./dist/entries/persistence.js"
    },
    "./context": {
      "types": "./dist/entries/context.d.ts",
      "default": "./dist/entries/context.js"
    },
    "./knowledge": {
      "types": "./dist/entries/knowledge.d.ts",
      "default": "./dist/entries/knowledge.js"
    },
    "./hitl": {
      "types": "./dist/entries/hitl.d.ts",
      "default": "./dist/entries/hitl.js"
    },
    "./guardrails": {
      "types": "./dist/entries/guardrails.d.ts",
      "default": "./dist/entries/guardrails.js"
    },
    "./usage": {
      "types": "./dist/entries/usage.d.ts",
      "default": "./dist/entries/usage.js"
    },
    "./mcp": {
      "types": "./dist/entries/mcp.d.ts",
      "default": "./dist/entries/mcp.js"
    },
    "./observability": {
      "types": "./dist/entries/observability.d.ts",
      "default": "./dist/entries/observability.js"
    },
    "./testing": {
      "types": "./dist/entries/testing.d.ts",
      "default": "./dist/entries/testing.js"
    },
    "./providers": {
      "types": "./dist/entries/providers.d.ts",
      "default": "./dist/entries/providers.js"
    },
    "./adapters/postgres": {
      "types": "./dist/entries/adapters-postgres.d.ts",
      "default": "./dist/entries/adapters-postgres.js"
    },
    "./adapters/redis": {
      "types": "./dist/entries/adapters-redis.d.ts",
      "default": "./dist/entries/adapters-redis.js"
    },
    "./adapters/bullmq": {
      "types": "./dist/entries/adapters-bullmq.d.ts",
      "default": "./dist/entries/adapters-bullmq.js"
    },
    "./adapters/otel": {
      "types": "./dist/entries/adapters-otel.d.ts",
      "default": "./dist/entries/adapters-otel.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/entries/server.d.ts",
      "default": "./dist/entries/server.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "node ../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "ai": "^7.0.66",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
