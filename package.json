{
  "name": "@retinue/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable AI agent platform \u2014 npm-workspaces monorepo (see docs/).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "shareflow",
    "examples",
    "services/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "npm run test --workspaces --if-present && npm run test:boundaries && npm run test:evals && npm run check:reachability && npm run check:scripts && npm run check:docs && npm run check:template && npm run check:terminology && npm run check:catalogue && npm run check:effects && node scripts/ci-local.mjs --verify",
    "test:boundaries": "node --test scripts/*.test.mjs",
    "test:evals": "node --test evals/*.test.mjs",
    "evals:coverage": "node evals/coverage.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:build": "npm --prefix website ci && npm --prefix website run build",
    "deploy": "npm run docs:build && npx wrangler deploy",
    "clean": "npm run clean --workspaces --if-present && rm -rf tsconfig.tsbuildinfo",
    "conformance:matrix": "node scripts/conformance-matrix.mjs backend/.conformance/vitest.json",
    "conformance:report": "rm -rf backend/.conformance/vitest.json && npm run test -w @retinue/agentkit -- --reporter=default --reporter=json --outputFile=.conformance/vitest.json",
    "conformance": "npm run conformance:report; npm run conformance:matrix",
    "release:gate": "node scripts/release-gate.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "security:review": "node scripts/security-review.mjs",
    "check:reachability": "node scripts/check-reachability.mjs",
    "check:scripts": "node scripts/check-script-imports.mjs",
    "check:docs": "node scripts/check-doc-imports.mjs",
    "check:consumer": "node scripts/check-consumer-boundary.mjs",
    "check:terminology": "node scripts/check-terminology.mjs",
    "check:domain": "node scripts/check-docs-domain.mjs",
    "check:catalogue": "node scripts/check-tool-catalogue.mjs",
    "check:effects": "node scripts/check-tool-effects.mjs",
    "changelog": "node scripts/changelog.mjs",
    "release:check": "node scripts/release-check.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "check:template": "node scripts/check-doc-template.mjs",
    "check:llms": "node scripts/check-llms.mjs"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
