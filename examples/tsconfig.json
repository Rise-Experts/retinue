{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.test.ts"],
  "references": [
    { "path": "../backend" },
    { "path": "../frontend" },
    { "path": "../tools/confluence" },
    { "path": "../tools/github" },
    { "path": "../tools/jira" },
    { "path": "../tools/linear" },
    { "path": "../tools/notion" },
    { "path": "../tools/slack" },
    { "path": "../tools/search" }
  ]
}
