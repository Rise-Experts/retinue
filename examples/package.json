{
  "name": "@agentkit/example-app",
  "version": "0.0.0",
  "private": true,
  "description": "A runnable app module and browser test surface for @agentkit (#155).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "api": "node --env-file=../.env ./scripts/run-api.mjs",
    "worker": "node --env-file=../.env ./scripts/run-worker.mjs",
    "migrate": "node --env-file=../.env ./scripts/migrate.mjs",
    "app": "node --env-file=../.env ./scripts/run-app.mjs"
  },
  "dependencies": {
    "@agentkit/backend": "*",
    "@agentkit/frontend": "*",
    "@agentkit/server": "*",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
