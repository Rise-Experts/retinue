{
  "name": "@retinue/example-app",
  "version": "0.1.0",
  "private": true,
  "description": "The reference application. Useful to read and to run; not a library, and its shape is allowed to change with whatever it is demonstrating.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-composer.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo public/composer.js public/composer.js.map",
    "api": "node --env-file=../.env ./scripts/run-api.mjs",
    "worker": "node --env-file=../.env ./scripts/run-worker.mjs",
    "migrate": "node --env-file=../.env ./scripts/migrate.mjs",
    "app": "node --env-file=../.env ./scripts/run-app.mjs",
    "loadtest": "node --env-file=../.env ./scripts/loadtest.mjs",
    "memory": "node --env-file=../.env ./scripts/run-memory.mjs",
    "test:kill": "node --env-file=../.env ./scripts/kill-worker-test.mjs",
    "build:composer": "node scripts/build-composer.mjs"
  },
  "dependencies": {
    "@retinue/agentkit": "^0.1.0",
    "@retinue/react": "^0.1.0",
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/azure": "^4.0.49",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/mistral": "^4.0.33",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-document": "^3.30.3",
    "@tiptap/extension-hard-break": "^3.30.3",
    "@tiptap/extension-paragraph": "^3.30.3",
    "@tiptap/extension-text": "^3.30.3",
    "@tiptap/extensions": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/suggestion": "^3.30.3",
    "@whatwg-node/server": "^0.11.0",
    "bullmq": "^6.2.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.0",
    "esbuild": "^0.25.12",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "@electric-sql/pglite": "^0.5.5"
  },
  "author": "Rise Experts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rise-Experts/retinue.git",
    "directory": "examples"
  }
}
