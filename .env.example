# Example app configuration (#155). Copy to `.env` and fill in real values.
#
# `.env` is gitignored; this file is committed. Never put a live value here — SEC-001 (#145) was a
# credential reaching a database column, and the same mistake in git history is worse because
# history is forever.

# ---------------------------------------------------------------- model
# Any OpenAI-compatible endpoint. Leave RETINUE_MODEL_BASE_URL unset for api.openai.com, or point it
# at a local server (Ollama, llama.cpp, Unsloth Studio, vLLM).
RETINUE_MODEL_API_KEY=sk-your-key-here
RETINUE_MODEL_ID=gpt-4o
# RETINUE_MODEL_BASE_URL=http://127.0.0.1:8888/v1

# ---------------------------------------------------------------- database
# The Postgres the example runs against. `supabase start` prints this URL; the value below is the
# local ShareFlow Supabase stack (supabase_db_social_integgration).
RETINUE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54342/postgres
# A dedicated schema, so the example never shares tables with anything else in that database.
RETINUE_EXAMPLE_SCHEMA=agentkit_example

# Redis, for the BullMQ queues. **Database 9, not 0.** The local stack's Redis is shared with the
# ShareFlow app on db 0 (a few hundred keys); a dedicated database number keeps the example's queues
# isolated and makes cleanup a `FLUSHDB` on 9 alone rather than a decision about someone else's keys.
RETINUE_REDIS_URL=redis://127.0.0.1:6379/9

# How the schema is provisioned at boot: auto | plan | off. `off` for the example — the schema is
# migrated once by hand, and a boot that silently migrated would make the example the thing that
# changes a database it shares with another project.
RETINUE_SCHEMA_MODE=off

# ---------------------------------------------------------------- dev auth
# The example's `authenticate` reads tenant and principal from request headers. It refuses to start
# without this flag: a permissive default in an example is how a permissive default reaches a
# deployment.
RETINUE_EXAMPLE_DEV_AUTH=1

# ---------------------------------------------------------------- integration toolkits
# All optional, and **wiring is the toggle**: a toolkit whose credential is absent contributes no
# tools at all, rather than tools that answer "not configured". The second kind costs the model a
# turn to discover and reads, in a transcript, exactly like a broken integration.
#
# Uncomment only what you have. Every one of these reaches a real third-party account.

# GITHUB_TOKEN=ghp_...
# SLACK_BOT_TOKEN=xoxb-...
# DISCORD_BOT_TOKEN=...
# TELEGRAM_BOT_TOKEN=...

# Jira and Confluence share one credential and one site — a token with no site URL is a mistake,
# not a partial configuration, so all three are needed or none of them.
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=...
# ATLASSIAN_SITE_URL=https://your-site.atlassian.net

# LINEAR_API_KEY=lin_api_...
# NOTION_TOKEN=secret_...

# Meta: each surface is toggled by its own id, so an account cleared for WhatsApp and not Instagram
# gets exactly the tools it can use.
# META_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_BUSINESS_ACCOUNT_ID=...
# INSTAGRAM_ACCOUNT_ID=...

# X_BEARER_TOKEN=...
# X_TIER=free
# Reddit wants a User-Agent identifying *this* deployment; a shared default would make every
# deployment look like one client to its rate limiter.
# REDDIT_ACCESS_TOKEN=...
# REDDIT_USER_AGENT_CONTACT=you@example.com

# --- Wave 2 -----------------------------------------------------------------
# Google Workspace. A **static token is a demonstration, not a pattern**: a Google access token
# expires in about an hour, so anything long-running needs withRefreshingCredentials against the
# tenant's OAuth grant. Fine for trying the example; not fine for a deployment.
# GOOGLE_ACCESS_TOKEN=ya29....

# Azure, read-first: the only write is a tag and the only destructive tool a restart.
# The same one-hour expiry caveat applies.
# AZURE_ACCESS_TOKEN=...

# Scraping. Needs no account — the direct provider is built in — so it is opt-in rather than
# credential-gated: fetching arbitrary URLs is a capability worth asking for. A hosted provider
# implies the opt-in.
# RETINUE_ENABLE_SCRAPE=1
# FIRECRAWL_API_KEY=fc-...
# JINA_API_KEY=jina_...
# SCRAPE_USER_AGENT=my-deployment (contact: you@example.com)

# Mail. EMAIL_FROM is required and deliberately has no default: it is the field SPF and DKIM align
# against, so a guessed sender produces mail that silently lands in spam. Read the integration page
# before the first send — most first sends fail on DNS, not on code.
# EMAIL_FROM=alerts@yourdomain.example
# EMAIL_REPLY_TO=support@yourdomain.example
# SMTP_HOST=smtp.yourprovider.example
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# ...or an HTTP provider instead of SMTP:
# RESEND_API_KEY=re_...

# `@retinue/tools-browser` is not wired in this app. It needs a BrowserDriver, and the package ships
# none on purpose — how a browser is launched and isolated is the operator's decision. See docs/30.

# ---------------------------------------------------------------- search
# One provider, chosen by name. The tool is the same whichever answers.
# RETINUE_SEARCH_PROVIDER=brave
# BRAVE_API_KEY=...
# TAVILY_API_KEY=...
# SERPER_API_KEY=...
# SEARXNG_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------- server
PORT=4000

# --- Renamed in #192 ---------------------------------------------------------
# Every variable above was AGENTKIT_* and is now RETINUE_*. The old names are
# still read for one minor release and warn when used, so an existing deployment
# keeps working while it is corrected. The warning is what makes the deprecation
# finite: silence would mean the fallback is still load-bearing a year from now
# and nobody knows.
