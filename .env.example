# Example app configuration (#155). Copy to `.env` and fill in real values.
#
# `.env` is gitignored; this file is committed. Never put a live value here — SEC-001 (#145) was a
# credential reaching a database column, and the same mistake in git history is worse because
# history is forever.

# ---------------------------------------------------------------- model
# Any OpenAI-compatible endpoint. Leave AGENTKIT_MODEL_BASE_URL unset for api.openai.com, or point it
# at a local server (Ollama, llama.cpp, Unsloth Studio, vLLM).
AGENTKIT_MODEL_API_KEY=sk-your-key-here
AGENTKIT_MODEL_ID=gpt-4o
# AGENTKIT_MODEL_BASE_URL=http://127.0.0.1:8888/v1

# ---------------------------------------------------------------- database
# The Postgres the example runs against. `supabase start` prints this URL; the value below is the
# local ShareFlow Supabase stack (supabase_db_social_integgration).
AGENTKIT_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54342/postgres
# A dedicated schema, so the example never shares tables with anything else in that database.
AGENTKIT_EXAMPLE_SCHEMA=agentkit_example

# Redis, for the BullMQ queues. **Database 9, not 0.** The local stack's Redis is shared with the
# ShareFlow app on db 0 (a few hundred keys); a dedicated database number keeps the example's queues
# isolated and makes cleanup a `FLUSHDB` on 9 alone rather than a decision about someone else's keys.
AGENTKIT_REDIS_URL=redis://127.0.0.1:6379/9

# How the schema is provisioned at boot: auto | plan | off. `off` for the example — the schema is
# migrated once by hand, and a boot that silently migrated would make the example the thing that
# changes a database it shares with another project.
AGENTKIT_SCHEMA_MODE=off

# ---------------------------------------------------------------- dev auth
# The example's `authenticate` reads tenant and principal from request headers. It refuses to start
# without this flag: a permissive default in an example is how a permissive default reaches a
# deployment.
AGENTKIT_EXAMPLE_DEV_AUTH=1

# ---------------------------------------------------------------- server
PORT=4000
